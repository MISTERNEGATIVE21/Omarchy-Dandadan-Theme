  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#616367", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.template", "string.quoted"],
      "settings": { "foreground": "#30A69D" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#FFA726" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator"],
      "settings": { "foreground": "#E1477A", "fontStyle": "bold" }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#D8B3FE" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#D8B3FE" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": { "foreground": "#FFA726", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#F0F4FC" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#E8759B" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#E1477A" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#D8B3FE" }
    },
    {
      "scope": ["support.type", "support.other.namespace"],
      "settings": { "foreground": "#30A69D" }
    },
    {
      "scope": ["meta.import", "keyword.control.import"],
      "settings": { "foreground": "#E1477A", "fontStyle": "bold" }
    },
    {
      "scope": ["punctuation.definition.string"],
      "settings": { "foreground": "#309FA6" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#E1477A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#D8B3FE", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#E8759B", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#30A69D" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#30A69D" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E1477A" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#FFA726" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#D8B3FE",
    "method": "#D8B3FE",
    "class": "#FFA726",
    "type": "#FFA726",
    "variable": "#F0F4FC",
    "parameter": "#E8759B",
    "property": "#F0F4FC",
    "enumMember": "#FFA726",
    "keyword": { "foreground": "#E1477A", "bold": true },
    "string": "#30A69D",
    "number": "#FFA726",
    "comment": { "foreground": "#616367", "italic": true }
  }
}
