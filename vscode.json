  "semanticTokenColors": {
    "function": "#D8B3FE",
    "method": "#D8B3FE",
    "class": "#FFA726",
    "type": "#FFA726",
    "variable": "#F0F4FC",
    "parameter": "#E8759B",
    "property": "#F0F4FC",
    "enumMember": "#FFA726",
    "keyword": {
      "foreground": "#E1477A",
      "bold": true
    },
    "string": "#30A69D",
    "number": "#FFA726",
    "comment": {
      "foreground": "#616367",
      "italic": true
    }
  }
