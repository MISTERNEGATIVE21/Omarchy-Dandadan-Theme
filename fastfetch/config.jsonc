{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.local/state/omarchy/current/theme/fastfetch/dandadan-ascii.txt",
    "color": {
      "1": "red",
      "2": "yellow"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄛 "
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} 󰄛 {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "red"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      "key": "󰔎 Theme",
      "format": "Dandadan Dynamic Anime Theme",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
