{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Dandadan",
  "author": "misternegative21",
  "themes": [
    {
      "name": "Dandadan",
      "appearance": "dark",
      "style": {
        "background": "#14161EF0",
        "editor.background": "#14161EF0",
        "editor.foreground": "#F0F4FC",
        "text": "#F0F4FC",
        "text.muted": "#F0F4FC99",
        "text.placeholder": "#F0F4FC66",
        "text.disabled": "#F0F4FC44",
        "text.accent": "#E80202",
        "icon": "#F0F4FC",
        "icon.muted": "#7E859E",
        "icon.disabled": "#F0F4FC44",
        "icon.placeholder": "#F0F4FC55",
        "icon.accent": "#E80202",
        "border": "#E8020255",
        "border.variant": "#E8020233",
        "border.focused": "#E80202",
        "border.selected": "#E80202",
        "border.transparent": "#00000000",
        "border.disabled": "#F0F4FC22",
        "elevated_surface.background": "#1A1D2A",
        "surface.background": "#14161E",
        "element.background": "#1A1D2A",
        "element.hover": "#E802021A",
        "element.active": "#E8020233",
        "element.selected": "#E8020222",
        "element.disabled": "#1A1D2A99",
        "drop_target.background": "#E802021A",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#E8020215",
        "ghost_element.active": "#E8020228",
        "ghost_element.selected": "#E802021F",
        "ghost_element.disabled": "#00000000",
        "link_text.hover": "#E80202",
        "conflict": "#E3847B",
        "conflict.background": "#E3847B15",
        "conflict.border": "#E3847B55",
        "created": "#50FA7B",
        "created.background": "#50FA7B15",
        "created.border": "#50FA7B55",
        "deleted": "#E3847B",
        "deleted.background": "#E3847B15",
        "deleted.border": "#E3847B55",
        "error": "#E3847B",
        "error.background": "#E3847B15",
        "error.border": "#E3847B55",
        "warning": "#F1FA8C",
        "warning.background": "#F1FA8C15",
        "warning.border": "#F1FA8C55",
        "info": "#7AA2F7",
        "info.background": "#7AA2F715",
        "info.border": "#7AA2F755",
        "players": [
          {
            "cursor": "#E80202",
            "background": "#E80202",
            "selection": "#E8020233"
          },
          {
            "cursor": "#7AA2F7",
            "background": "#7AA2F7",
            "selection": "#7AA2F733"
          }
        ],
        "syntax": {
          "keyword": {
            "color": "#EF02F5",
            "weight": 700
          },
          "function": {
            "color": "#00F5D4"
          },
          "type": {
            "color": "#F1FA8C"
          },
          "variable": {
            "color": "#F0F4FC"
          },
          "string": {
            "color": "#50FA7B"
          },
          "number": {
            "color": "#FF9E64"
          },
          "comment": {
            "color": "#7E859E",
            "font_style": "italic"
          },
          "operator": {
            "color": "#E80202"
          },
          "punctuation": {
            "color": "#C5CDE3"
          },
          "tag": {
            "color": "#E3847B"
          },
          "attribute": {
            "color": "#F1FA8C"
          }
        }
      }
    }
  ]
}